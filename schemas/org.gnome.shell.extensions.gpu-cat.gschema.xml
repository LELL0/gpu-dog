<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
	<enum id="org.gnome.shell.extensions.gpu-cat.DisplayingItems">
		<value value="0" nick="character-and-percentage" />
		<value value="1" nick="percentage-only" />
		<value value="2" nick="character-only" />
	</enum>

	<enum id="org.gnome.shell.extensions.gpu-cat.Character">
		<value value="0" nick="cat" />
		<value value="1" nick="dog" />
	</enum>

	<schema
		id="org.gnome.shell.extensions.gpu-cat"
		path="/org/gnome/shell/extensions/gpu-cat/"
	>

		<key type="i" name="idle-threshold">
			<default>5</default>
			<summary>Idle threshold</summary>
		</key>

		<key name="displaying-items" enum="org.gnome.shell.extensions.gpu-cat.DisplayingItems">
			<default>'character-only'</default>
			<summary>Displaying items</summary>
		</key>

		<key name="invert-speed" type="b">
			<default>false</default>
			<summary>Invert speed</summary>
		</key>

		<key name="smooth-speed-changes" type="b">
			<default>true</default>
			<summary>Smooth speed changes</summary>
		</key>

		<key name="character" enum="org.gnome.shell.extensions.gpu-cat.Character">
			<default>'cat'</default>
			<summary>Character</summary>
			<description>Which animal runs in the panel</description>
		</key>

		<key name="color" type="s">
			<default>''</default>
			<summary>Character color</summary>
			<description>CSS color of the character, e.g. '#76b900'. Empty: pick from the GPU vendor (NVIDIA green, AMD red, Intel blue).</description>
		</key>

		<key name="custom-system-monitor-enabled" type="b">
			<default>false</default>
			<summary>Enable custom system monitor</summary>
		</key>

		<key name="custom-system-monitor-command" type="s">
			<default>'gnome-system-monitor -r'</default>
			<summary>Custom system monitor command</summary>
		</key>
	</schema>
</schemalist>
